{
  "name": "skillslink-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CLI and GitHub Pages viewer for AI-readable Markdown links.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @vidigal-code/skillslink && npm run build --workspace @skillslink/web",
    "build:package": "npm run build --workspace @vidigal-code/skillslink",
    "build:web": "npm run build --workspace @skillslink/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "npm run dev --workspace @skillslink/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint eslint.config.mjs apps packages scripts",
    "pack:check": "npm pack --workspace @vidigal-code/skillslink --dry-run",
    "release:version": "node scripts/set-release-version.mjs",
    "test": "npm run test:release && npm run test --workspaces --if-present",
    "test:release": "node --test scripts/release-version.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.3",
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-yak": "^1.3.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
